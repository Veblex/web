{
    "$schema": "https://v2-9-14.turborepo.dev/schema.json",
    "ui": "tui",
    "tasks": {
        "build": {
            "cache": false,
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": [
                ".next/**",
                "!.next/cache/**",
                "dist/**",
                ".astro/**",
                ".vercel/output/**"
            ]
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "format": {
            "dependsOn": ["^format"]
        },
        "typecheck": {
            "dependsOn": ["^typecheck"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}
