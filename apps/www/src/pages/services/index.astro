---
import { Layers } from "@lucide/astro";
import { Services as ServicesComp } from "@components/services";

import Layout from "@layouts/root.astro";
import CTA from "@components/basic-cta.astro";
---

<Layout
    page="Services"
    title="Veblex Services - Gym, Calendar, Auth & More"
    description="Explore the Veblex service suite: Gym, Calendar, Auth (SSO), plus Mail, Insights, and Cloud coming soon. Modular and integrated."
>
    <main class="flex-1">
        {/* Hero */}
        <section
            class="container mx-auto grid min-h-[60vh] px-4 py-24 sm:px-6 lg:max-w-3xl lg:items-center lg:px-8 lg:text-center"
        >
            <div>
                <span
                    class="flex w-fit items-center gap-2 rounded-full bg-secondary px-6 py-2 text-xs text-muted-foreground uppercase lg:mx-auto"
                >
                    <Layers class="size-4" />
                    Services
                </span>
                <h1
                    class="mt-8 mb-6 text-4xl leading-tight font-bold md:text-6xl"
                >
                    Everything you need, one <span class="text-gradient"
                        >ecosystem</span
                    >
                </h1>
                <p
                    class="text-muted-foreground sm:text-lg lg:mx-auto lg:max-w-xl"
                >
                    From fitness tracking to authentication, every Veblex
                    service is modular, production-ready, and designed to work
                    together seamlessly.
                </p>
            </div>
        </section>

        {/* Services */}
        <section class="border-t border-border">
            <div class="container mx-auto px-4 py-24 sm:px-6 lg:px-8">
                <div>
                    <span
                        class="font-mono text-sm text-muted-foreground uppercase"
                    >
                        Available & Upcoming
                    </span>
                    <h2
                        class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl"
                    >
                        The full lineup
                    </h2>
                </div>
                <div
                    class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2"
                >
                    <ServicesComp titleTag="h3" />
                </div>
            </div>
        </section>

        <CTA secondaryActionText="About Veblex" secondaryActionHref="/about" />
    </main>
</Layout>
