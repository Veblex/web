---
import Layout from "@layouts/root.astro";
import { ArrowRight, Cookie, FileText, Shield } from "@lucide/astro";
import { Card } from "@workspace/ui/components/card";

const legalPages = [
    {
        icon: Shield,
        title: "Privacy Policy",
        description:
            "Learn how Veblex collects, uses, and protects your personal data across all ecosystem services.",
        href: "/legal/privacy",
        featured: false,
    },
    {
        icon: FileText,
        title: "Terms of Service",
        description:
            "Review the terms and conditions governing your use of the Veblex ecosystem and all its products.",
        href: "/legal/terms",
        featured: true,
    },
    {
        icon: Cookie,
        title: "Cookie Policy",
        description:
            "Understand how Veblex uses cookies and similar technologies to enhance your browsing experience.",
        href: "/legal/cookies",
        featured: false,
    },
];
---

<Layout
    page="Legal"
    title="Legal - Veblex Privacy, Terms & Cookies"
    description="Review Veblex legal policies: Privacy Policy, Terms of Service, and Cookie Policy. Transparency across the Veblex ecosystem."
>
    <main class="flex-1">
        <section
            class="container mx-auto mt-16 space-y-20 px-4 py-8 sm:px-6 lg:px-8"
        >
            <div class="mx-auto max-w-2xl">
                <h1 class="my-4 text-4xl font-bold tracking-tight">
                    Legal & Policies
                </h1>

                <p class="text-lg text-muted-foreground">
                    Transparency matters. Review the policies that govern the
                    Veblex ecosystem and how we protect your rights.
                </p>
            </div>

            <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
                {
                    legalPages.map((page) => (
                        <a
                            href={page.href}
                            class={
                                page.featured
                                    ? "grid md:row-span-2 xl:row-span-1"
                                    : ""
                            }
                        >
                            <Card doHover={true}>
                                <h2 class="text-2xl font-bold tracking-tight">
                                    {page.title}
                                </h2>

                                <p class="flex-1 text-muted-foreground">
                                    {page.description}
                                </p>

                                <span class="mt-auto flex items-center gap-1 pt-6 transition-all duration-300 group-hover/card:ml-1.5">
                                    Read more <ArrowRight class="size-5" />
                                </span>
                            </Card>
                        </a>
                    ))
                }
            </div>
        </section>
    </main>
</Layout>
