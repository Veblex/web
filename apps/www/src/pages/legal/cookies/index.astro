---
import { PrevNext } from "@/components/prev-next";
import Layout from "@layouts/root.astro";
import { ArrowLeft } from "@lucide/astro";
---

<Layout
    page="Cookie Policy"
    description="How Veblex uses cookies and similar technologies across our services."
>
    <main class="flex-1">
        <article class="container mx-auto max-w-2xl px-4 py-16 sm:px-6 lg:px-8">
            <section>
                <a
                    href="/legal"
                    class="flex items-center gap-1.5 font-mono text-muted-foreground uppercase underline-offset-2 transition-all duration-300 hover:underline"
                >
                    <ArrowLeft class="size-4" />
                    Legal
                </a>
                <h1 class="my-4 text-4xl font-bold tracking-tight sm:text-4xl">
                    Cookie Policy
                </h1>
                <p class="text-lg text-muted-foreground">
                    How Veblex uses cookies and similar technologies.
                </p>
                <p class="mt-4 text-muted-foreground">
                    Last updated: September 1, 2026
                </p>
            </section>

            <section id="what-are-cookies" class="mt-12">
                <h2 class="text-xl">What Are Cookies</h2>
                <p class="mt-2 text-muted-foreground">
                    Cookies are small text files stored on your device when you
                    visit Veblex services. They help us remember preferences,
                    analyze usage, and deliver a seamless experience across the
                    ecosystem.
                </p>
            </section>

            <section id="essential-cookies" class="mt-12">
                <h2 class="text-2xl">Essential Cookies</h2>
                <p class="mt-2 text-muted-foreground">
                    These cookies are necessary for Veblex services to function
                    properly, including authentication via Veblex Auth, session
                    management, and security features.
                </p>
            </section>

            <section id="analytics-cookies" class="mt-12">
                <h2 class="text-2xl">Analytics Cookies</h2>
                <p class="mt-2 text-muted-foreground">
                    We use analytics cookies to understand how users interact
                    with Veblex services. This data helps us improve performance
                    and user experience across all products.
                </p>
            </section>

            <section id="preference-cookies" class="mt-12">
                <h2 class="text-2xl">Preference Cookies</h2>
                <p class="mt-2 text-muted-foreground">
                    These cookies remember your settings and choices — such as
                    language, theme, and layout preferences — so you don't have
                    to reconfigure them on each visit.
                </p>
                <p class="mt-4 text-muted-foreground">
                    When you choose a light or dark appearance (today, by
                    pressing the D key on Veblex sites), we store that choice in
                    a first-party cookie named{" "}
                    <span class="code">veblex-theme</span> on{" "}
                    <span class="code">.veblex.com</span> for one year, and also
                    in per-site local storage. The cookie is only set after that
                    explicit choice. Until then we follow your operating system
                    preference and any per-site local storage already on the
                    device.
                </p>
                <p class="mt-4 text-muted-foreground">
                    This cookie is not set on third-party domains such as
                    Moviestix. Those sites keep their own per-origin storage.
                </p>
            </section>

            <section id="managing-cookies" class="mt-12">
                <h2 class="text-2xl">Managing Cookies</h2>
                <p class="mt-2 text-muted-foreground">
                    You can control cookies through your browser settings. Note
                    that disabling certain cookies may affect the functionality
                    of Veblex services.
                </p>
            </section>

            <section id="contact" class="mt-12">
                <h2 class="text-2xl">Contact</h2>
                <p class="mt-2 text-muted-foreground">
                    For questions about our cookie practices, contact us at <a
                        href="mailto:legal@veblex.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="underline underline-offset-2">legal@veblex.com</a
                    >.
                </p>
            </section>

            <PrevNext
                className="mt-12 border-t border-border pt-12"
                prev={{ url: "/legal/terms", title: "Terms of Service" }}
                next={{ url: "/legal/privacy", title: "Privacy Policy" }}
            />
        </article>
    </main>
</Layout>
