---
import { Layers, Zap, Lock, Globe, Puzzle } from "@lucide/astro";

import { VBadgeDark, VBadgeLight } from "@workspace/ui/brand-icons";
import { Card } from "@workspace/ui/components/card";

import { roadmap } from "@/data/roadmap";

import Layout from "@layouts/root.astro";

const principles = [
    {
        name: "Modular by Design",
        description:
            "Every Veblex service is self-contained yet interconnected. Use one or use them all — they integrate seamlessly.",
        icon: Puzzle,
    },
    {
        name: "Security First",
        description:
            "Veblex Auth provides a unified SSO layer so users authenticate once and access every service securely.",
        icon: Lock,
    },
    {
        name: "Developer Experience",
        description:
            "Consistent APIs, shared design language, and thorough documentation make building on Veblex fast and intuitive.",
        icon: Zap,
    },
    {
        name: "Built for Scale",
        description:
            "From solo projects to enterprise deployments, the Veblex ecosystem grows with you — no re-architecture needed.",
        icon: Globe,
    },
];
---

<Layout
    page="About"
    title="About Veblex - The Unified Digital Ecosystem for Fitness & Security"
    description="Learn how Veblex unifies modular services under one identity, design language, and auth layer. Built for developers and teams."
    footer={{ showCTA: true }}
>
    <main class="flex-1">
        {/* Hero */}
        <section
            class="container mx-auto grid min-h-[60vh] px-4 py-24 sm:px-6 lg:max-w-4xl lg:items-center lg:px-8 lg:text-center"
        >
            <div>
                <h1
                    class="flex w-fit items-center gap-2 rounded-full bg-secondary px-6 py-2 text-xs text-muted-foreground uppercase lg:mx-auto"
                >
                    <Layers class="size-4" />
                    About Veblex
                </h1>
                <h2
                    class="mt-8 mb-6 text-4xl leading-tight font-bold md:text-6xl"
                >
                    The Unified <span class="text-gradient">Ecosystem</span> for <span
                        class="text-gradient">Fitness</span
                    > & Security
                </h2>
                <p class="text-muted-foreground sm:text-lg">
                    Veblex brings together a growing suite of services — Gym,
                    Calendar, Auth, and more — under a single identity. Every
                    product shares the same design language, authentication
                    layer, and developer experience.
                </p>
            </div>
        </section>

        {/* Mission */}
        <section class="border-t border-border">
            <div class="container mx-auto px-4 py-24 sm:px-6 lg:px-8">
                <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
                    <div>
                        <h2
                            class="font-mono text-sm text-muted-foreground uppercase"
                        >
                            Our Mission
                        </h2>
                        <h3
                            class="my-4 text-3xl font-bold tracking-tight sm:text-4xl"
                        >
                            Simplify the stack, amplify the experience
                        </h3>
                        <div
                            class="space-y-4 text-lg leading-relaxed text-muted-foreground"
                        >
                            <p>
                                Modern teams juggle dozens of disconnected
                                tools. Veblex replaces that fragmentation with a
                                unified ecosystem where every service works
                                together out of the box — shared auth, shared
                                data, shared design.
                            </p>
                            <p>
                                Whether you&apos;re tracking workouts, managing
                                schedules, or securing access, Veblex handles it
                                under one roof so you can focus on what matters.
                            </p>
                        </div>
                    </div>

                    <div class="hidden items-center justify-center lg:flex">
                        <div class="relative">
                            <div
                                class="absolute inset-0 rounded-2xl bg-primary/40 blur-3xl"
                            >
                            </div>
                            <VBadgeLight
                                className="pointer-events-none size-48 animate-float select-none not-dark:hidden"
                            />
                            <VBadgeDark
                                className="pointer-events-none size-48 animate-float select-none dark:hidden"
                            />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {/* Principles */}
        <section class="container mx-auto px-4 py-24 sm:px-6 lg:px-8">
            <div>
                <h2 class="font-mono text-sm text-muted-foreground uppercase">
                    Core Principles
                </h2>
                <h3 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
                    Why Veblex exists
                </h3>
            </div>

            <div
                class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2"
            >
                {
                    principles.map((value) => (
                        <Card>
                            <div class="hidden size-10 items-center justify-center rounded-lg bg-secondary md:flex">
                                <value.icon class="size-5 text-foreground" />
                            </div>
                            <h4 class="font-semibold md:mt-4">{value.name}</h4>
                            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                                {value.description}
                            </p>
                        </Card>
                    ))
                }
            </div>
        </section>

        {/* Roadmap */}
        <section class="border-t border-border">
            <div class="container mx-auto px-4 py-24 sm:px-6 lg:px-8">
                <div>
                    <h2
                        class="font-mono text-sm text-muted-foreground uppercase"
                    >
                        Roadmap
                    </h2>
                    <h3 class="mt-4 text-3xl font-bold tracking-tight">
                        Where we're headed
                    </h3>
                </div>
                <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                    {
                        roadmap.map((value) => (
                            <Card>
                                <span class="font-mono text-sm text-muted-foreground uppercase">
                                    {value.phase}
                                </span>
                                <h4 class="my-2 text-lg font-semibold">
                                    {value.title}
                                </h4>
                                <p class="text-sm leading-relaxed text-muted-foreground">
                                    {value.description}
                                </p>
                            </Card>
                        ))
                    }
                </div>
            </div>
        </section>
    </main>
</Layout>
