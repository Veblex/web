---
import { ArrowRight, ChevronRight } from "@lucide/astro";

import { VBadgeDark, VBadgeLight } from "@workspace/ui/brand-icons";
import { buttonVariants } from "@workspace/ui/components/button";
import { Card } from "@workspace/ui/components/card";

import { Services as ServicesComp } from "@components/services";
import { stats } from "@/data/stats";

import Layout from "@layouts/root.astro";
import { cn } from "@workspace/ui/lib/utils";

import { Orbit } from "@components/homepage/hero/orbit";
---

<Layout
    title="Veblex - Your everyday tools, all in one place"
    description="Veblex is a free collection of everyday tools — track your workouts, manage your watchlist, and more. One account, everything you need."
>
    <main class="flex-1">
        {/* Hero */}
        <section
            class="relative flex min-h-screen flex-col items-center justify-center"
        >
            {/* Background color blobs */}
            <div
                class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_70%_40%,var(--accent),transparent_60%)] opacity-60"
            >
            </div>

            <div
                class="relative container grid grid-cols-1 overflow-clip px-4 py-12 sm:px-6 sm:py-18 lg:px-8 xl:grid-cols-2"
            >
                <div class="flex flex-col justify-center">
                    <h1
                        class="text-5xl font-bold tracking-tight text-balance sm:text-6xl lg:text-7xl"
                    >
                        One free account.<br />
                        <span class="text-primary">Every</span> Veblex service.
                    </h1>

                    <p
                        class="my-8 text-base leading-relaxed text-pretty text-muted-foreground sm:text-lg"
                    >
                        Sign up for Veblex Auth at no cost and get secure access
                        to our growing family of apps — fitness, calendar,
                        movies, and plenty more on the way.
                    </p>

                    <div class="flex flex-wrap items-center gap-4">
                        <a
                            href="https://auth.veblex.com/"
                            class={cn(
                                buttonVariants({
                                    variant: "default",
                                    size: "lg",
                                }),
                                "shadow-primary/20 shadow-lg font-semibold"
                            )}
                        >
                            Create your free account
                            <ArrowRight class="size-4" />
                        </a>
                        <a
                            class={cn(
                                buttonVariants({
                                    variant: "link",
                                }),
                                "font-semibold text-foreground"
                            )}
                            href="/services"
                        >
                            Explore all services
                        </a>
                    </div>
                </div>

                <Orbit className="hidden xl:flex" />
            </div>
        </section>

        {/* Services */}
        <section>
            <div class="container mx-auto px-4 py-24 sm:px-6 sm:py-32 lg:px-8">
                <h2 class="font-mono text-sm text-muted-foreground uppercase">
                    Services
                </h2>
                <h3 class="my-4 text-3xl font-bold tracking-tight sm:text-4xl">
                    Built to work together
                </h3>
                <p class="text-lg leading-relaxed text-muted-foreground">
                    A growing ecosystem of interconnected applications designed
                    to enhance every aspect of your digital life.
                </p>

                <div class="mt-12 grid gap-6 lg:grid-cols-3">
                    <ServicesComp
                        showFeatures={false}
                        onlyCore={true}
                        limit={3}
                        titleTag="h4"
                    />
                </div>

                <div class="mt-12 flex justify-center">
                    <a
                        class={buttonVariants({
                            variant: "secondary",
                            size: "lg",
                        })}
                        href="/services"
                    >
                        Explore all services
                        <ChevronRight class="size-5" />
                    </a>
                </div>
            </div>
        </section>

        {/* About */}
        <section class="border-t border-border">
            <div class="container mx-auto px-4 py-24 sm:px-6 sm:py-32 lg:px-8">
                <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
                    <div>
                        <h2
                            class="font-mono text-sm text-muted-foreground uppercase"
                        >
                            About Veblex
                        </h2>

                        <h3
                            class="my-4 text-3xl font-bold tracking-tight sm:text-4xl"
                        >
                            An ecosystem, not just a product
                        </h3>

                        <p
                            class="text-lg leading-relaxed text-muted-foreground"
                        >
                            Veblex brings together a growing suite of services
                            under a single identity. Every product shares the
                            same design language, auth layer, and developer
                            experience — so you can build faster with fewer
                            tools.
                        </p>

                        <div class="mt-4 grid items-center gap-4 sm:flex">
                            <a
                                class={buttonVariants({
                                    variant: "default",
                                    size: "lg",
                                })}
                                href="https://auth.veblex.com/"
                            >
                                Create Your Account
                                <ArrowRight class="size-4" />
                            </a>
                            <a
                                class={buttonVariants({
                                    variant: "outline",
                                    size: "lg",
                                })}
                                href="/about"
                            >
                                Learn more
                                <ChevronRight class="size-4" />
                            </a>
                        </div>
                    </div>

                    <div
                        class="grid gap-6 md:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2"
                    >
                        {
                            stats.map((stat) => (
                                <Card size="lg">
                                    <p class="flex flex-col gap-2 text-center text-sm leading-relaxed text-muted-foreground">
                                        <span class="text-3xl font-bold text-foreground">
                                            {stat.value}
                                        </span>
                                        <br />
                                        {stat.title}
                                    </p>
                                </Card>
                            ))
                        }
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>
