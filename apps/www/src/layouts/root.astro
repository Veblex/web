---
import "@workspace/ui/styles/globals.css";
import { ThemeProvider } from "@workspace/ui/components/theme-provider";

import Header from "@components/header.astro";
import Footer from "@components/footer.astro";

import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";

const origin = Astro.site?.origin ?? "";
const ogUrl = `${origin}/og.png`;
const url = `${origin}${Astro.url.pathname}`;

type FooterConfig = {
    showCTA?: boolean;
};
const defaultFooterConfig: FooterConfig = {
    showCTA: false,
};

const {
    title,
    page,
    description,
    author,
    do_not_index,
    footer = defaultFooterConfig,
}: {
    title?: string;
    page?: string;
    description?: string;
    author?: string;
    do_not_index?: boolean;
    footer?: FooterConfig;
} = Astro.props;
const page_title =
    !title && page ? `${page} - Veblex` : !title && !page ? "Veblex" : title;
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <script is:inline>
            const theme = localStorage.getItem("theme") ?? "system";
            const resolved =
                theme === "system"
                    ? window.matchMedia("(prefers-color-scheme: dark)").matches
                        ? "dark"
                        : "light"
                    : theme;
            document.documentElement.classList.add(resolved);
        </script>

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <link rel="canonical" href={url} />

        <meta name="generator" content={Astro.generator} />

        <meta
            name="robots"
            content={do_not_index === true
                ? "noindex, nofollow"
                : "index, follow"}
        />

        <title>{page_title}</title>
        <meta name="description" content={description} />
        <meta name="author" content={!author ? "Veblex" : author} />

        <meta property="og:type" content="website" />
        <meta name="og:url" content={url} />
        <meta name="og:title" content={page_title} />
        <meta name="og:description" content={description} />
        <meta name="og:site_name" content="Veblex" />
        <meta property="og:image" content={ogUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={page_title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogUrl} />
        <meta property="twitter:url" content={url} />
        <meta property="twitter:domain" content={origin} />

        <ClientRouter />

        <Font cssVariable="--font-sans" preload />
        <Font cssVariable="--font-heading" preload />
    </head>
    <body>
        <ThemeProvider client:load>
            <div class="flex min-h-screen flex-col">
                <Header />
                <slot />
                <Footer {...footer} />
            </div>
        </ThemeProvider>
    </body>
</html>
