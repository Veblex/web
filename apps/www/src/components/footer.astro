---
import { FullLight, GitHub } from "@workspace/ui/brand-icons";
import { UptimeWidget } from "@workspace/ui/components/uptime-widget";
import { CTA, type CTAProps } from "@components/cta";
import { ExternalLink } from "@lucide/astro";
import { services } from "@/data/services";

const { showCTA = false }: { showCTA?: boolean } = Astro.props;

const pathname = new URL(Astro.request.url).pathname;
const isServicesPage = pathname.startsWith("/services");
const ctaProps: CTAProps = isServicesPage
    ? {
          buttons: {
              secondary: {
                  title: "About Veblex",
                  href: "/about",
              },
          },
      }
    : {};

const year = new Date().getFullYear();
const FOOTER_LINKS_VISIBLE = 5;

const socialLinks = [
    {
        name: "GitHub",
        href: "https://vblx.cc/github",
        icon: GitHub,
    },
    // {
    //     name: "Discord",
    //     href: "https://vblx.cc/discord",
    //     icon: Discord,
    // },
    // {
    //     name: "YouTube",
    //     href: "https://vblx.cc/youtube",
    //     icon: YouTube,
    // },
];

type Link = {
    name: string;
    href: string;
    target?: "_blank" | "_self" | "_parent" | "_top";
};

const footerLinks: {
    title: string;
    links: Link[];
}[] = [
    {
        title: "Services",
        links: services
            .filter(
                (service) =>
                    service.status === "released" ||
                    service.status === "in progress"
            )
            .map(
                (service): Link => ({
                    name: service.title,
                    href: service.href,
                })
            ),
    },
    {
        title: "Company",
        links: [
            { name: "Services", href: "/services" },
            { name: "About", href: "/about" },
            { name: "Press", href: "/press" },
            { name: "Blog", href: "/blog" },
        ],
    },
    {
        title: "Resources",
        links: [
            { name: "Documentation", href: "/docs" },
            { name: "Help Center", href: "/help" },
            { name: "Contact Us", href: "/contact" },
            {
                name: "Status",
                href: "https://status.veblex.com/",
                target: "_blank",
            },
        ],
    },
    {
        title: "Legal",
        links: [
            { name: "Privacy Policy", href: "/legal/privacy" },
            { name: "Terms of Service", href: "/legal/terms" },
            { name: "Cookie Policy", href: "/legal/cookies" },
        ],
    },
];

const pixelsSvg = await fetch(
    "https://assets.veblex.com/illustrations/footer-pixels/v2/pixels.min.svg"
).then((r) => r.text());
---

{showCTA && <CTA {...ctaProps} />}

<footer class="relative">
    <div
        class="relative -mb-px leading-none [&_svg]:block [&_svg]:w-full"
        set:html={pixelsSvg}
        aria-hidden="true"
    />

    <div class="bg-footer text-footer-foreground">
        <!-- Top bar -->
        <div
            class="container mx-auto flex flex-col justify-between gap-6 gap-y-16 px-4 py-12 sm:px-6 lg:flex-row lg:px-8 lg:py-16"
        >
            <!-- Brand -->
            <div>
                <a href="/" class="flex max-w-28">
                    <span class="sr-only">Veblex homepage</span>
                    <FullLight />
                </a>

                <p
                    class="mt-4 max-w-xs text-sm leading-relaxed text-footer-foreground/70"
                >
                    Your unified digital ecosystem. One account, endless
                    possibilities.
                </p>

                <div class="mt-6 flex items-center gap-2">
                    {
                        socialLinks.map((link) => (
                            <a
                                href={link.href}
                                class="dark rounded-full border border-primary/10 bg-card p-2 text-muted-foreground transition-colors duration-300 hover:border-foreground hover:bg-foreground hover:text-background"
                                aria-label={`Veblex on ${link.name}`}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <link.icon className="size-5" />
                            </a>
                        ))
                    }
                </div>
            </div>

            <!-- Links -->
            <div
                class="flex flex-wrap gap-12 sm:gap-16 lg:gap-20 xl:grid xl:grid-cols-4"
            >
                {
                    footerLinks.map((col) => (
                        <div class="flex basis-32 flex-col">
                            <h2 class="font-sans text-sm font-semibold">
                                {col.title}
                            </h2>
                            <ul class="mt-4 space-y-3">
                                {col.links.map((link, index) => (
                                    <li
                                        class="flex"
                                        {...(index >= FOOTER_LINKS_VISIBLE
                                            ? { "data-footer-link-extra": "" }
                                            : {})}
                                    >
                                        <a
                                            href={link.href}
                                            class="flex items-center gap-1 text-sm text-footer-foreground/80 transition-colors hover:text-footer-foreground"
                                            target={link.target ?? "_self"}
                                        >
                                            {link.name}
                                            {link.target === "_blank" && (
                                                <ExternalLink class="mb-1.5 size-3" />
                                            )}
                                        </a>
                                    </li>
                                ))}
                                {col.links.length > FOOTER_LINKS_VISIBLE && (
                                    <li
                                        class="hidden"
                                        data-footer-link-toggle-wrap
                                    >
                                        <button
                                            type="button"
                                            class="cursor-pointer text-sm text-footer-foreground/80 underline transition-colors hover:text-footer-foreground"
                                            data-footer-link-toggle
                                            aria-expanded="false"
                                        >
                                            Show more
                                        </button>
                                    </li>
                                )}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Bottom bar -->
        <div class="border-t border-footer-foreground/10">
            <div
                class="container mx-auto flex flex-row items-center justify-between gap-4 px-4 py-6 sm:px-6 lg:px-8"
            >
                <p class="text-sm text-footer-foreground/60">
                    &copy; {year} Veblex. All rights reserved.
                </p>

                <UptimeWidget
                    client:only="react"
                    className="text-footer-foreground/60 not-xs:hidden"
                />
            </div>
        </div>
    </div>
</footer>

<script>
    const initFooterLinkLists = () => {
        const footer = document.querySelector("footer");
        if (!footer) {
            return;
        }

        footer.querySelectorAll("ul").forEach((list) => {
            const toggle = list.querySelector("[data-footer-link-toggle]");
            const toggleWrap = list.querySelector(
                "[data-footer-link-toggle-wrap]"
            );
            const extras = list.querySelectorAll("[data-footer-link-extra]");

            if (!toggle || !toggleWrap || extras.length === 0) {
                return;
            }

            toggleWrap.classList.remove("hidden");
            extras.forEach((item) => item.classList.add("hidden"));
            toggle.setAttribute("aria-expanded", "false");
            toggle.textContent = "Show more";
        });
    };

    const onFooterLinkToggleClick = (event: Event) => {
        const target = event.target;
        if (!(target instanceof Element)) {
            return;
        }

        const toggle = target.closest("[data-footer-link-toggle]");
        if (!toggle) {
            return;
        }

        const footer = toggle.closest("footer");
        if (!footer) {
            return;
        }

        const list = toggle.closest("ul");
        if (!list) {
            return;
        }

        const extras = list.querySelectorAll("[data-footer-link-extra]");
        const expanded = toggle.getAttribute("aria-expanded") === "true";

        extras.forEach((item) => item.classList.toggle("hidden", expanded));
        toggle.setAttribute("aria-expanded", expanded ? "false" : "true");
        toggle.textContent = expanded ? "Show more" : "Hide";
    };

    const setupFooterLinkToggles = () => {
        document.addEventListener("click", onFooterLinkToggleClick);
        initFooterLinkLists();
    };

    setupFooterLinkToggles();
    document.addEventListener("astro:after-swap", initFooterLinkLists);
</script>
